<div id="call" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <button type="button" data-close class="popup__close">
                <svg aria-hidden="true" width="13" height="13">
                    <use xlink:href="img/sprite.svg#close"></use>
                </svg>
            </button>
            <div class="popup-forms__body">
                <div class="popup-forms__top">
                    <div class="popup-forms__title">
                        Заказать звонок
                    </div>
                </div>
                <form data-popup-message="#thanks" action="#" data-dev class="form">
                    <div class="form__inputs">
                        <div class="form__input">
                            <div class="form__icon">
                                <svg aria-hidden="true" width="12" height="14">
                                    <use xlink:href="img/sprite.svg#user"></use>
                                </svg>
                            </div>
                            <input data-required autocomplete="off" type="text" placeholder="Ваше имя" class="input">
                        </div>
                        <div class="form__input">
                            <div class="form__icon">
                                <svg aria-hidden="true" width="14" height="14">
                                    <use xlink:href="img/sprite.svg#phone2"></use>
                                </svg>
                            </div>
                            <input data-required autocomplete="off" type="text" placeholder="Номер телефона"
                                class="input telephone">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-red">
                        <span>Заказать звонок</span>
                        <div class="btn__icon">
                            <svg aria-hidden="true" width="8" height="12">
                                <use xlink:href="img/sprite.svg#arrow1"></use>
                            </svg>
                        </div>
                    </button>
                    <div class="form__text">
                        Нажимая кнопку, вы соглашаетесь с <a href="./">политикой конфиденциальности</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="thanks" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <svg aria-hidden="true" width="16" height="16">
                    <use xlink:href="img/sprite.svg#close"></use>
                </svg>
            </div>
            <div class="popup-forms__body">
                <div class="popup-forms__top">
                    <div class="popup-forms__title">Спасибо за заявку!</div>
                    <p>
                        Свяжимся с вами в ближайшее время.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>